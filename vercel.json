{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/monthly-report",
      "schedule": "0 0 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/go/:key",
      "destination": "/index.html"
    },
    {
      "source": "/check",
      "destination": "/check.html"
    },
    {
      "source": "/free",
      "destination": "/free.html"
    },
    {
      "source": "/blackbox",
      "destination": "/blackbox.html"
    }
  ]
}
